# Copy to ddpm.env.local, edit, and source FROM THE PROJECT ROOT.
export CHANNEL_LAB_DDPM_MODEL="$PWD/channel_lab/models/ddpm-cifar10-32"
export CHANNEL_LAB_EXPERIMENT_RUNS="$PWD/channel_lab/experiment_runs"
# cpu default. mps requires a supported Mac/PyTorch; cuda is not for Mac.
export CHANNEL_LAB_DDPM_DEVICE="cpu"
