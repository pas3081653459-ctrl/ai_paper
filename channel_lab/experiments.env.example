# Source from project root after copying to experiments.env.local.
export CHANNEL_LAB_CLIP_MODEL="$PWD/channel_lab/models/clip-vit-base-patch32"
export CHANNEL_LAB_CLIP_DEVICE="cpu"
export CHANNEL_LAB_BERT_MODEL="$PWD/channel_lab/models/bert"
export CHANNEL_LAB_GPT2_MODEL="$PWD/channel_lab/models/gpt2"
# GPT-3 lesson 08 reuses this GPT-2 model as an explicitly labeled substitute.
# Full language-category setup and record formats: LANGUAGE_CATEGORY.md.
export CHANNEL_LAB_LANGUAGE_DEVICE="cpu"
# Shared local model lock and DDPM records. Keep identical for all backend processes.
export CHANNEL_LAB_EXPERIMENT_RUNS="$PWD/channel_lab/experiment_runs"
# Optional ReAct model mode: fill in a server you have already configured.
# Full chat-completions URL, NOT only /v1. Only loopback addresses accepted.
export CHANNEL_LAB_REACT_ENDPOINT="http://127.0.0.1:1234/v1/chat/completions"
export CHANNEL_LAB_REACT_MODEL=""
# Optional credential for your local service; never put it in frontend files.
# export CHANNEL_LAB_REACT_API_KEY="..."

# Image-intervention lessons; directories must already contain matching local files.
export CHANNEL_LAB_VIT_MODEL="$PWD/channel_lab/models/vit"
export CHANNEL_LAB_SAM_MODEL="$PWD/channel_lab/models/sam"
export CHANNEL_LAB_LLAVA_MODEL="$PWD/channel_lab/models/llava"
export CHANNEL_LAB_VISION_DEVICE="cpu"
export CHANNEL_LAB_VISION_DTYPE="float32"
# CPU LLaVA can be slow and require substantial RAM; no automatic offload/quantization.
# float16 is accepted only with mps/cuda. Requests may be cancelled in the page.
export CHANNEL_LAB_VISION_TIMEOUT="600"
