# Code-only update on top of a dependency base image (no pip at all, takes seconds).
# channel-lab:base = `docker build --target deps` of deploy/Dockerfile (wheelhouse, pinned deps).
# Paper PDFs are NOT in the image; run.sh mounts /home/ubuntu/channel_lab_papers.
ARG BASE=channel-lab:base
FROM ${BASE}
RUN rm -rf /app/channel_lab
COPY channel_lab /app/channel_lab
RUN mkdir -p /app/channel_lab/models /app/experiment_runs /app/papers
